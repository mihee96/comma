ENVIRONMENT=local

# 로컬 개발: SQLite (설정 없이 바로 실행됨)
DATABASE_URL=sqlite:///./dev.db

# 운영: AWS RDS MySQL 예시 (requirements-prod.txt 설치 필요)
# DATABASE_URL=mysql+pymysql://comma:PASSWORD@comma-db.xxxxxxxx.ap-northeast-2.rds.amazonaws.com:3306/comma?charset=utf8mb4
# SSL 강제 시:  ...&ssl_ca=/etc/ssl/certs/rds-combined-ca-bundle.pem

# openssl rand -hex 32 로 생성
SECRET_KEY=dev-secret-change-me
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# 콤마 구분, 전체 허용은 *
BACKEND_CORS_ORIGINS=*
